      "response": [
        {
          "name": "201 Created - New Chat",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": \"11cf9ae0-fd32-47b4-950e-08bdd110c67a\",\n  \"userBId\": \"3d01b685-f3e3-447d-8e7d-09bb53ce5f48\"\n}"
